DATABASE_URL=postgres://postgres:postgres@localhost:5432/texmoto
SESSION_TTL_DAYS=30
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_DRIVER=local
INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
META_GRAPH_API_VERSION=vXX.X
# Use the Graph API version configured for your Meta app, for example vXX.X.
# STORAGE_DRIVER=s3 switches to S3-compatible object storage (AWS S3, Cloudflare R2,
# MinIO, ...). Images are proxied through the app at /s3/<key>, so the bucket can stay
# private. Leave STORAGE_DRIVER=local for single-instance setups.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=texmoto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
